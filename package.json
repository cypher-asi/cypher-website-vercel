{
  "name": "cypher-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "next dev",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "site:create": "node --env-file-if-exists=.env.local scripts/create-site.mjs",
    "site:rotate-key": "node --env-file-if-exists=.env.local scripts/rotate-site-key.mjs",
    "posts:import": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-posts.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "lucide-react": "0.469.0",
    "mixpanel-browser": "2.80.0",
    "next": "15.5.29",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/mixpanel-browser": "2.60.0",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
