{
  "name": "cypher-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "next dev",
    "predev:poll": "node scripts/predev.mjs",
    "dev:poll": "next dev",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "site:create": "node --env-file-if-exists=.env.local scripts/create-site.mjs",
    "site:rotate-key": "node --env-file-if-exists=.env.local scripts/rotate-site-key.mjs",
    "posts:import": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-posts.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@vercel/blob": "2.9.0",
    "lucide-react": "1.77.0",
    "mixpanel-browser": "2.86.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/mixpanel-browser": "2.60.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "zod": "^4.6.6"
  }
}
