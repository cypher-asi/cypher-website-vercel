# Copy to `.env.local` and fill in. Never commit real keys.

# Mixpanel public project token for cypher.net. Client-side (NEXT_PUBLIC_*), so
# it is inlined at build time: changing it needs a rebuild. If unset, analytics
# is a silent no-op (see src/features/analytics/mixpanel.ts).
NEXT_PUBLIC_MIXPANEL_TOKEN_CYPHER=
