# Copy to `.env.local` and fill in, or run `vercel env pull .env.local`.
# Never commit real keys.

# Neon Postgres holding sites, posts and the research index. The Neon
# integration on the Vercel project sets it. Locally, see "Local database" in
# the README.
DATABASE_URL=

# Private Vercel Blob store for post images. The Blob integration sets it.
BLOB_READ_WRITE_TOKEN=

# Mixpanel public project token for cypher.net. Client-side (NEXT_PUBLIC_*), so
# it is inlined at build time: changing it needs a rebuild. If unset, analytics
# is a silent no-op (see src/features/analytics/mixpanel.ts).
NEXT_PUBLIC_MIXPANEL_TOKEN_CYPHER=
